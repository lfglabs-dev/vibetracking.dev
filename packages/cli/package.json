{
  "name": "vibetracking",
  "version": "0.2.0",
  "description": "Track AI coding assistant token usage and costs across Claude Code, Codex, Cursor, and more.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "vibetracking": "./dist/cli.js"
  },
  "files": [
    "dist/**/*"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lfglabs/vibetracking.git",
    "directory": "packages/cli"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bun run --conditions=browser src/cli.ts",
    "start": "bun run --conditions=browser dist/cli.js",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@starknetid/vibetracking-core": "^0.2.0",
    "clipboardy": "^5.0.2",
    "commander": "^14.0.2",
    "csv-parse": "^5.6.0",
    "date-fns": "^4.1.0",
    "open": "^10.1.0",
    "pako": "^2.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/pako": "^2.0.4",
    "typescript": "^5.0.0"
  },
  "engines": {
    "bun": ">= 1.0"
  },
  "keywords": [
    "vibetracking",
    "claude-code",
    "cursor",
    "codex",
    "ai-usage",
    "token-tracker",
    "cli"
  ]
}
